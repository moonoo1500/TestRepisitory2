; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

name="КРОШЕВО: Протокол Демонтажа"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/icons/icon.png"
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)

[autoload]

GameState="*res://src/core/game_state.gd"
SaveSystem="*res://src/core/save_system.gd"
Localization="*res://src/localization/localization_manager.gd"
LevelManager="*res://src/core/level_manager.gd"
PerformanceBudget="*res://src/core/performance_budget.gd"
PoolManager="*res://src/systems/pooling.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/resizable=true
window/handheld/orientation=1
window/vsync/vsync_mode=0

